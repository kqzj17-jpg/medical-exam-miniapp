page {
  height: 100%;
  overflow: hidden;
  background: #d4d0c8;
  color: #000;
  font-size: 14px;
  line-height: 1.4;
  font-family: SimSun, "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  box-sizing: border-box;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  font-size: inherit;
  line-height: inherit;
  font-family: inherit;
}

button::after {
  border: none;
}

.viewport {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: #d4d0c8;
  overflow: hidden;
}

.stage {
  width: 1280px;
  height: 800px;
  overflow: hidden;
  background: #d4d0c8;
}

.win-btn {
  background: #e6e6e6;
  color: #000;
  border-style: solid;
  border-width: 2px;
  border-color: #fff #6e6e6e #6e6e6e #fff;
  font-size: 13px;
  height: 28px;
  line-height: 24px;
  padding: 0 12px;
  border-radius: 0;
}

.win-btn:active {
  border-color: #6e6e6e #fff #fff #6e6e6e;
}

.titlebar {
  height: 32px;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: center;
  padding: 0 10px;
  font-size: 14px;
  font-weight: 700;
  flex-shrink: 0;
}

.titlebar .demo {
  margin-left: 10px;
  font-size: 12px;
  font-weight: 400;
  opacity: 0.9;
}

.desk {
  width: 1280px;
  height: 768px;
  background: #3a6ea5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.win {
  background: #d4d0c8;
  border-style: solid;
  border-width: 2px;
  border-color: #fff #404040 #404040 #fff;
}
