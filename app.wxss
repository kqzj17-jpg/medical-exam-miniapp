page {
  height: 100%;
  width: 100%;
  overflow: hidden;
  background: #f3f5f8;
  color: #1a1d24;
  font-size: 14px;
  line-height: 1.5;
  font-family: "PingFang SC", -apple-system, "Noto Sans SC", "Helvetica Neue", sans-serif;
  box-sizing: border-box;
}

view,
text,
button,
input,
scroll-view,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  font-size: inherit;
  line-height: inherit;
  font-family: inherit;
  min-width: 0;
  width: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

button::after {
  border: none;
}

.shell {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #f3f5f8;
}

.portrait-shell {
  background: #f3f5f8;
  padding-bottom: env(safe-area-inset-bottom);
  padding-left: env(safe-area-inset-left);
  padding-right: env(safe-area-inset-right);
}

.exam-shell,
.result-shell {
  background: #e8edf4;
  padding-top: env(safe-area-inset-top);
  padding-right: env(safe-area-inset-right);
  padding-bottom: env(safe-area-inset-bottom);
  padding-left: env(safe-area-inset-left);
}

.titlebar {
  height: 32px;
  min-height: 32px;
  background: #1b4f9c;
  color: #fff;
  display: flex;
  align-items: center;
  padding: 0 12px;
  font-size: 14px;
  font-weight: 600;
  flex-shrink: 0;
  letter-spacing: 0.2px;
}

.portrait-shell .titlebar {
  height: auto;
  min-height: calc(44px + env(safe-area-inset-top));
  padding-top: env(safe-area-inset-top);
  padding-right: 96px;
  padding-left: 16px;
  font-size: 17px;
  font-weight: 600;
}

.titlebar .demo {
  margin-left: 8px;
  font-size: 11px;
  font-weight: 400;
  opacity: 0.95;
  border: 1px solid rgba(255, 255, 255, 0.4);
  border-radius: 10px;
  padding: 0 7px;
  height: 18px;
  line-height: 16px;
}

.win-btn {
  background: #f4f6f9;
  color: #1a1d24;
  border: 1px solid #c5cedb;
  font-size: 13px;
  height: 28px;
  line-height: 26px;
  padding: 0 12px;
  border-radius: 4px;
  flex-shrink: 0;
  min-width: 0;
  width: auto;
}

.win-btn:active {
  background: #e4eaf2;
}

.win-btn.primary {
  background: #1b4f9c;
  color: #fff;
  border-color: #163f7c;
}

.win-btn.primary:active {
  background: #163f7c;
}

.win-btn.mini {
  height: 22px;
  line-height: 20px;
  padding: 0 8px;
  font-size: 11px;
}

.desk {
  flex: 1;
  min-height: 0;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 12px;
}

.win {
  background: #e8edf4;
  border: 1px solid #c5cedb;
  border-radius: 8px;
  max-width: 100%;
  max-height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
