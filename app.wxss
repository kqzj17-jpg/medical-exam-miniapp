page {
  height: 100%;
  width: 100%;
  overflow: hidden;
  background: #d4d0c8;
  color: #000;
  font-size: 13px;
  line-height: 1.4;
  font-family: SimSun, "Songti SC", "Noto Serif SC", "PingFang SC", serif;
  box-sizing: border-box;
}

view,
text,
button,
input,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: none;
  font-size: inherit;
  line-height: inherit;
  font-family: inherit;
  min-width: 0;
  width: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

button::after {
  border: none;
}

.shell {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: #d4d0c8;
  padding-top: env(safe-area-inset-top);
  padding-right: env(safe-area-inset-right);
  padding-bottom: env(safe-area-inset-bottom);
  padding-left: env(safe-area-inset-left);
}

.win-btn {
  background: #ececec;
  color: #111;
  border-style: solid;
  border-width: 2px;
  border-color: #fff #6a6a6a #6a6a6a #fff;
  font-size: 13px;
  height: 28px;
  line-height: 24px;
  padding: 0 12px;
  border-radius: 0;
  flex-shrink: 0;
  min-width: 0;
  width: auto;
}

.win-btn:active {
  border-color: #6a6a6a #fff #fff #6a6a6a;
  background: #e0e0e0;
}

.win-btn.primary {
  background: #3a63a8;
  color: #fff;
  border-color: #7ea0d4 #1d3c73 #1d3c73 #7ea0d4;
}

.win-btn.primary:active {
  border-color: #1d3c73 #7ea0d4 #7ea0d4 #1d3c73;
  background: #335892;
}

.win-btn.mini {
  height: 22px;
  line-height: 18px;
  padding: 0 8px;
  font-size: 11px;
}

.titlebar {
  height: 32px;
  min-height: 32px;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: center;
  padding: 0 12px;
  font-size: 14px;
  font-weight: 700;
  flex-shrink: 0;
  letter-spacing: 0.2px;
}

.titlebar .demo {
  margin-left: 10px;
  font-size: 11px;
  font-weight: 400;
  opacity: 0.95;
  border: 1px solid rgba(255, 255, 255, 0.45);
  padding: 0 6px;
  height: 18px;
  line-height: 16px;
}

.desk {
  flex: 1;
  min-height: 0;
  width: 100%;
  background: #3a6ea5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10px 12px;
}

.win {
  background: #d4d0c8;
  border-style: solid;
  border-width: 2px;
  border-color: #fff #404040 #404040 #fff;
  max-width: 100%;
  max-height: 100%;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
