<page-meta page-orientation="landscape" />
<view class="shell exam-shell" style="{{shellStyle}}">
  <view class="titlebar" style="{{titlebarStyle}}">
    <text>{{productName}}</text>
    <text class="demo">{{productTag}}</text>
  </view>

  <view class="workspace">
    <view class="sidebar">
      <view class="photo">
        <image wx:if="{{candidate.avatarUrl}}" class="photo-img" src="{{candidate.avatarUrl}}" mode="aspectFill" />
        <block wx:else>
          <view class="sil-head"></view>
          <view class="sil-body"></view>
        </block>
        <view class="photo-cap">{{candidate.demo ? '演示' : '头像'}}</view>
      </view>

      <view class="field">
        <view class="lab">姓名</view>
        <view class="val">{{candidate.nickname || candidate.name}}</view>
      </view>
      <view class="field">
        <view class="lab">手机号</view>
        <view class="val">{{candidate.phoneMasked || '—'}}</view>
      </view>
      <view class="field">
        <view class="lab">练习时间</view>
        <view class="val">{{candidate.examTime}}</view>
      </view>
      <view class="field">
        <view class="lab">剩余时间</view>
        <view class="remain {{timeUrgent ? 'urgent' : ''}}">{{remainingText}}</view>
      </view>
      <view class="stats">
        <view class="stat tap" bindtap="onJumpUnanswered">
          <view class="lab">未答题</view>
          <view class="val num">{{unansweredCount}}</view>
        </view>
        <view class="stat tap" bindtap="onJumpFlagged">
          <view class="lab">标疑题</view>
          <view class="val num">{{flaggedCount}}</view>
        </view>
      </view>

      <view class="side-btns">
        <button class="win-btn" bindtap="onRefresh">刷新</button>
        <button class="win-btn primary" bindtap="onAskSubmit">交卷</button>
      </view>

      <view class="rule">注意：练习分若干段进行。进入下一段后，本段试题将不能回看和修改。</view>

      <view class="sec-list">
        <view
          wx:for="{{sections}}"
          wx:key="id"
          class="sec {{item.current ? 'on' : ''}} {{item.locked ? 'locked' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTapSection"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="main">
      <view class="typebar">
        <text class="type-name">题型 {{typeLabel}}</text>
        <text class="type-hint">{{typeHint}}</text>
      </view>
      <scroll-view class="qarea" scroll-y>
        <view wx:if="{{isLocked}}" class="locked-box">
          <view class="lock-title">本段已锁定</view>
          <view class="lock-desc">进入下一段后，本段试题将无法再查看或修改。</view>
        </view>
        <block wx:else>
          <view class="case" wx:if="{{question.caseStem}}">
            <view class="case-title">{{question.caseTitle}}</view>
            <view class="case-stem">{{question.caseStem}}</view>
          </view>
          <view class="stem">{{displayNo}}. {{question.stem}}</view>
          <view
            wx:for="{{question.options}}"
            wx:key="key"
            class="opt {{selected === item.key ? 'on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onSelect"
          >
            <view class="chk"><text wx:if="{{selected === item.key}}">✓</text></view>
            <view class="opt-text">{{item.key}}. {{item.text}}</view>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <view class="nav">
    <view class="ops">
      <view class="ops-left">
        <button class="win-btn {{flagged ? 'marked' : ''}}" bindtap="onFlag">{{flagged ? '取消标疑' : '标疑'}}</button>
        <button class="win-btn" bindtap="onJumpUnanswered">转到未答题</button>
        <button class="win-btn" bindtap="onJumpFlagged">转到标疑题</button>
      </view>
      <view class="ops-right">
        <button class="win-btn" bindtap="onPrev">上一题</button>
        <button class="win-btn" bindtap="onNext">下一题</button>
      </view>
    </view>
    <view class="grid">
      <view
        wx:for="{{grid}}"
        wx:key="id"
        class="cell {{item.status}} {{item.current ? 'current' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTapGrid"
      >{{item.no}}</view>
    </view>
    <view class="legend">
      <view class="lg lg-flag">标疑</view>
      <view class="lg lg-miss">未答</view>
      <view class="lg lg-ok">已答</view>
    </view>
  </view>

  <view class="mask" wx:if="{{dialog.show}}" catchtouchmove="noop">
    <view class="dlg">
      <view class="dlg-bar">{{dialog.title}}</view>
      <scroll-view class="dlg-body" scroll-y>
        <view class="dlg-p">{{dialog.content}}</view>
        <view class="dlg-sum" wx:if="{{dialog.summary.length}}">
          <view class="dlg-sum-h">未答汇总</view>
          <view class="dlg-sum-row" wx:for="{{dialog.summary}}" wx:key="id">
            <text class="dlg-sum-k">{{item.name}}{{item.locked ? '（已锁定）' : ''}}</text>
            <text class="dlg-sum-v">{{item.count}} 题：{{item.nosText}}</text>
          </view>
        </view>
      </scroll-view>
      <view class="dlg-ops">
        <button wx:if="{{dialog.cancelText}}" class="win-btn" bindtap="onDialogCancel">{{dialog.cancelText}}</button>
        <button class="win-btn primary" bindtap="onDialogConfirm">{{dialog.confirmText}}</button>
      </view>
    </view>
  </view>
</view>
