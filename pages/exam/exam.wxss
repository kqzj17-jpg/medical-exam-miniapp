.exam-shell {
  position: relative;
  font-family: "PingFang SC", -apple-system, "Noto Sans SC", sans-serif;
}

.workspace {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  width: 100%;
  gap: 16px;
  padding-right: 8px;
  box-sizing: border-box;
}

.sidebar {
  width: 18%;
  min-width: 140px;
  max-width: 180px;
  height: 100%;
  flex-shrink: 0;
  background: #f4f6fa;
  border-right: 1px solid #d5dce6;
  padding: 6px 8px;
  overflow-y: auto;
}

.photo {
  width: 44px;
  height: 52px;
  margin: 0 auto 6px;
  background: #d9dee8;
  border-radius: 8px;
  position: relative;
  overflow: hidden;
}

.photo-img {
  width: 44px;
  height: 52px;
}

.sil-head {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #8e97a8;
  position: absolute;
  left: 14px;
  top: 6px;
}

.sil-body {
  width: 28px;
  height: 20px;
  border-radius: 12px 12px 0 0;
  background: #8e97a8;
  position: absolute;
  left: 8px;
  top: 24px;
}

.photo-cap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2px;
  text-align: center;
  font-size: 10px;
  color: #5b6472;
}

.field {
  margin-bottom: 4px;
}

.lab {
  font-size: 11px;
  color: #667085;
}

.val {
  font-size: 13px;
  font-weight: 650;
  word-break: break-all;
  margin-top: 1px;
}

.val.num {
  font-size: 16px;
  color: #1b4f9c;
}

.remain {
  margin-top: 2px;
  background: #f8d0df;
  border: 1px solid #e39ab4;
  border-radius: 6px;
  text-align: center;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 1px;
  padding: 3px 0;
}

.remain.urgent {
  background: #d24b73;
  color: #fff;
  border-color: #9a2f50;
}

.stats {
  display: flex;
  margin: 2px 0 6px;
}

.stat {
  flex: 1;
  background: #fff;
  border: 1px solid #e4e8f0;
  border-radius: 6px;
  padding: 4px 6px;
  margin-right: 6px;
}

.stat:last-child {
  margin-right: 0;
}

.tap:active {
  background: #eef3fb;
}

.side-btns {
  display: flex;
  margin: 4px 0 8px;
}

.side-btns .win-btn {
  flex: 1;
  margin-right: 6px;
  padding: 0 4px;
  font-size: 12px;
}

.side-btns .win-btn:last-child {
  margin-right: 0;
}

.rule {
  color: #b42318;
  font-size: 11px;
  line-height: 1.45;
  margin-bottom: 8px;
}

.sec-list {
  border: 1px solid #d5dce6;
  border-radius: 8px;
  background: #fff;
  overflow: hidden;
}

.sec {
  font-size: 12px;
  padding: 6px 8px;
}

.sec.on {
  background: #1b4f9c;
  color: #fff;
}

.sec.locked:not(.on) {
  color: #98a2b3;
}

.main {
  flex: 1;
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.typebar {
  flex-shrink: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 4px 20px;
  min-height: 28px;
  background: #f7f9fc;
  border-bottom: 1px solid #e4e8f0;
  display: flex;
  align-items: center;
}

.type-name {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 650;
  color: #1b4f9c;
  margin-right: 10px;
  padding-top: 1px;
}

.type-hint {
  flex: 1;
  min-width: 0;
  font-size: 11px;
  color: #3a4150;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qarea {
  flex: 1;
  width: 100%;
  height: 0;
  min-height: 0;
  padding: 0;
}

.q-col {
  width: 100%;
  max-width: 720px;
  margin-left: auto;
  margin-right: auto;
  padding: 10px 28px 12px;
  box-sizing: border-box;
}

.qarea::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.q-start {
  height: 0;
}

.case {
  margin-bottom: 10px;
  padding: 10px 12px;
  background: #f7f9fc;
  border: 1px solid #e4e8f0;
  border-radius: 8px;
}

.case-title {
  font-size: 12px;
  font-weight: 650;
  margin-bottom: 4px;
  color: #1b4f9c;
}

.case-stem {
  font-size: 13px;
  line-height: 1.5;
}

.stem {
  font-size: 14px;
  line-height: 1.5;
  margin-bottom: 8px;
}

.opt {
  display: flex;
  align-items: flex-start;
  padding: 5px 8px;
  margin-bottom: 4px;
  border: 1px solid #edf0f5;
  border-radius: 6px;
}

.opt.on {
  background: #fff8d6;
  border-color: #1b4f9c;
}

.chk {
  width: 16px;
  height: 16px;
  border: 1px solid #667085;
  border-radius: 3px;
  background: #fff;
  margin-right: 8px;
  margin-top: 2px;
  flex-shrink: 0;
  text-align: center;
  font-size: 11px;
  line-height: 14px;
}

.opt-text {
  flex: 1;
  font-size: 14px;
  line-height: 1.45;
}

.locked-box {
  padding: 40px 16px;
  text-align: center;
}

.lock-title {
  font-size: 20px;
  font-weight: 700;
  color: #b42318;
}

.lock-desc {
  margin-top: 8px;
  font-size: 13px;
  color: #667085;
}

.nav {
  flex-shrink: 0;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  background: #f4f6fa;
  border-top: 1px solid #d5dce6;
  padding: 4px 8px 2px;
}

.ops {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin-bottom: 4px;
}

.ops-left {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.ops-right {
  flex: 0 0 auto;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  margin-left: 8px;
}

.ops .win-btn {
  min-width: 0 !important;
  width: auto;
  padding: 0 6px;
  font-size: 11px;
  height: 24px;
  line-height: 22px;
  margin: 0 6px 2px 0;
}

.ops-left .win-btn:last-child {
  margin-right: 0;
}

.ops-right .win-btn {
  flex-shrink: 0;
  margin-bottom: 0;
}

.ops-right .win-btn:last-child {
  margin-right: 0;
}

.ops .win-btn.marked {
  background: #ffe566;
  border-color: #e3c200;
}

.grid-scroll {
  width: 100%;
  max-height: 32px;
  height: 32px;
}

.grid-scroll::-webkit-scrollbar {
  width: 0;
  height: 0;
  display: none;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
}

.cell {
  min-width: 22px;
  width: 22px;
  height: 16px;
  padding: 0;
  margin: 0 2px 2px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  color: #fff;
  border-radius: 3px;
}

.cell.unanswered {
  background: #cc2f2f;
}

.cell.answered {
  background: #7d7d7d;
}

.cell.flagged {
  background: #e3c200;
  color: #222;
}

.cell.current {
  box-shadow: inset 0 0 0 2px #111;
}

.legend {
  display: flex;
  align-items: center;
  font-size: 10px;
  color: #5b6472;
  padding-top: 0;
}

.lg {
  margin-right: 12px;
  padding-left: 14px;
  position: relative;
}

.lg::before {
  content: '';
  position: absolute;
  left: 0;
  top: 3px;
  width: 9px;
  height: 9px;
  border-radius: 2px;
}

.lg-flag::before {
  background: #e3c200;
}

.lg-miss::before {
  background: #cc2f2f;
}

.lg-ok::before {
  background: #7d7d7d;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(16, 24, 40, 0.36);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dlg {
  width: 72%;
  max-width: 460px;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.dlg-bar {
  background: #1b4f9c;
  color: #fff;
  font-size: 14px;
  font-weight: 650;
  padding: 10px 14px;
}

.dlg-body {
  margin: 0;
  padding: 14px 16px;
  background: #fff;
  font-size: 13px;
  line-height: 1.55;
  height: 148px;
}

.dlg-p {
  margin-bottom: 8px;
}

.dlg-sum {
  border-top: 1px solid #edf0f5;
  padding-top: 8px;
}

.dlg-sum-h {
  font-weight: 650;
  color: #1b4f9c;
  margin-bottom: 6px;
}

.dlg-sum-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 4px;
  font-size: 12px;
}

.dlg-sum-k {
  color: #667085;
  margin-right: 10px;
  flex-shrink: 0;
}

.dlg-sum-v {
  font-weight: 650;
  text-align: right;
  min-width: 0;
  word-break: break-all;
}

.dlg-ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 14px 14px;
}

.dlg-ops .win-btn {
  margin-left: 8px;
  min-width: 88px;
}
