.page {
  height: 100%;
  background: #c8c8c8;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.titlebar {
  flex-shrink: 0;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: flex-end;
  padding-left: 16rpx;
  padding-bottom: 8rpx;
}

.title-text {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.title-demo {
  margin-left: 12rpx;
  font-size: 18rpx;
  opacity: 0.85;
}

.workspace {
  flex: 1;
  height: 0;
  display: flex;
  flex-direction: row;
  min-height: 0;
}

.sidebar {
  width: 228rpx;
  flex-shrink: 0;
  height: 100%;
  background: #ececec;
  border-right: 2rpx solid #808080;
  padding: 10rpx 10rpx 16rpx;
}

.photo {
  width: 112rpx;
  height: 140rpx;
  margin: 0 auto 8rpx;
  background: #d0d0d0;
  border: 2rpx solid #808080;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  position: relative;
}

.silhouette {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.head {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #9aa3ad;
}

.body {
  width: 64rpx;
  height: 48rpx;
  margin-top: 6rpx;
  background: #9aa3ad;
  border-radius: 28rpx 28rpx 0 0;
}

.photo-cap {
  font-size: 16rpx;
  color: #666;
  margin-bottom: 4rpx;
  z-index: 1;
}

.field {
  margin-bottom: 6rpx;
}

.field.tap:active {
  background: #ddd;
}

.lab {
  font-size: 16rpx;
  color: #333;
}

.val {
  font-size: 18rpx;
  font-weight: 700;
  word-break: break-all;
}

.val.ticket {
  font-size: 16rpx;
  letter-spacing: 0;
}

.val.num {
  font-size: 22rpx;
}

.remain {
  margin-top: 2rpx;
  background: #ff9ec8;
  color: #000;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
  padding: 4rpx 0;
  border: 2rpx solid #cc5a8a;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.remain.urgent {
  background: #ff5e8a;
  color: #fff;
}

.side-btns {
  display: flex;
  margin: 8rpx 0 10rpx;
}

.side-btns .win-btn {
  flex: 1;
  height: 38rpx;
  line-height: 34rpx;
  font-size: 16rpx;
  padding: 0 4rpx;
  margin-right: 6rpx;
}

.side-btns .win-btn:last-child {
  margin-right: 0;
}

.finish {
  font-weight: 700;
}

.rule {
  color: #cc0000;
  font-size: 16rpx;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.sec-list {
  border: 2rpx solid #808080;
  background: #fff;
}

.sec {
  font-size: 18rpx;
  padding: 6rpx 8rpx;
  color: #000;
}

.sec.on {
  background: #316ac5;
  color: #fff;
}

.sec.locked:not(.on) {
  color: #666;
}

.main {
  flex: 1;
  width: 0;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.typebar {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  background: #f3f3f3;
  border-bottom: 2rpx solid #b0b0b0;
  display: flex;
  align-items: flex-start;
}

.type-name {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #1f4b99;
  margin-right: 12rpx;
}

.type-hint {
  flex: 1;
  font-size: 18rpx;
  color: #333;
  line-height: 1.4;
}

.qarea {
  flex: 1;
  height: 0;
  padding: 10rpx 16rpx 8rpx;
  background: #fff;
}

.case {
  margin-bottom: 10rpx;
  padding: 8rpx 10rpx;
  background: #f7f7f7;
  border: 2rpx solid #c8c8c8;
}

.case-title {
  font-size: 18rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.case-stem {
  font-size: 20rpx;
  line-height: 1.5;
}

.stem {
  font-size: 22rpx;
  line-height: 1.55;
  margin-bottom: 10rpx;
}

.options {
  padding-bottom: 8rpx;
}

.opt {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 8rpx;
  margin-bottom: 6rpx;
  border: 2rpx solid transparent;
}

.opt.on {
  background: #fff4a3;
  border-color: #1f4b99;
}

.chk {
  width: 22rpx;
  height: 22rpx;
  border: 2rpx solid #333;
  background: #fff;
  margin-right: 10rpx;
  margin-top: 2rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  line-height: 1;
  color: #000;
}

.opt-text {
  flex: 1;
  font-size: 20rpx;
  line-height: 1.45;
}

.locked-box {
  padding: 40rpx 20rpx;
  text-align: center;
}

.lock-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #cc0000;
}

.lock-desc {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #333;
}

.bottom {
  flex-shrink: 0;
  background: #ececec;
  border-top: 2rpx solid #808080;
  padding: 6rpx 10rpx 8rpx;
}

.ops {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.ops .win-btn {
  margin-right: 8rpx;
  height: 36rpx;
  line-height: 32rpx;
  font-size: 18rpx;
  padding: 0 12rpx;
}

.ops .win-btn.marked {
  background: #ffe566;
}

.ops-spacer {
  flex: 1;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  min-width: 40rpx;
  height: 28rpx;
  padding: 0 4rpx;
  margin: 0 4rpx 4rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: #fff;
}

.cell.unanswered {
  background: #e00000;
}

.cell.answered {
  background: #8a8a8a;
}

.cell.flagged {
  background: #f0d000;
  color: #000;
}

.cell.current {
  box-shadow: inset 0 0 0 2rpx #000;
}

.legend {
  font-size: 16rpx;
  color: #333;
  margin-top: 2rpx;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.28);
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dlg {
  width: 520rpx;
  background: #ececec;
  border: 2rpx solid #fff;
  border-right-color: #404040;
  border-bottom-color: #404040;
  box-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.25);
}

.dlg-bar {
  background: #1f4b99;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 10rpx;
}

.dlg-body {
  padding: 20rpx 18rpx 12rpx;
  font-size: 20rpx;
  line-height: 1.6;
  background: #fff;
  margin: 8rpx;
  min-height: 80rpx;
}

.dlg-ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 10rpx 10rpx;
}

.dlg-ops .win-btn {
  margin-left: 10rpx;
  min-width: 140rpx;
  height: 40rpx;
  line-height: 36rpx;
}

.dlg-ok {
  font-weight: 700;
}
