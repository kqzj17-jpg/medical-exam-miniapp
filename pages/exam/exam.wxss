.exam-shell {
  position: relative;
}

.workspace {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  width: 100%;
}

.sidebar {
  width: 24%;
  min-width: 168px;
  max-width: 280px;
  height: 100%;
  flex-shrink: 0;
  background: #ece9e0;
  border-right: 1px solid #808080;
  padding: 8px 10px;
  overflow-y: auto;
}

.photo {
  width: 64px;
  height: 80px;
  margin: 0 auto 6px;
  background: #c8c8c8;
  border: 1px solid #666;
  position: relative;
}

.sil-head {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #8e97a0;
  position: absolute;
  left: 21px;
  top: 10px;
}

.sil-body {
  width: 40px;
  height: 28px;
  border-radius: 16px 16px 0 0;
  background: #8e97a0;
  position: absolute;
  left: 12px;
  top: 34px;
}

.photo-cap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 1px;
  text-align: center;
  font-size: 10px;
  color: #555;
}

.field {
  margin-bottom: 6px;
}

.lab {
  font-size: 11px;
  color: #555;
}

.val {
  font-size: 13px;
  font-weight: 700;
  word-break: break-all;
  margin-top: 1px;
}

.val.num {
  font-size: 16px;
  color: #1f4b99;
}

.remain {
  margin-top: 4px;
  background: #f3b0cc;
  border: 1px solid #c45a86;
  text-align: center;
  font-size: 17px;
  font-weight: 700;
  letter-spacing: 1px;
  padding: 5px 0;
}

.remain.urgent {
  background: #d24b73;
  color: #fff;
  border-color: #9a2f50;
}

.stats {
  display: flex;
  margin: 2px 0 6px;
}

.stat {
  flex: 1;
  background: #fff;
  border: 1px solid #c8c4bb;
  padding: 4px 6px;
  margin-right: 6px;
}

.stat:last-child {
  margin-right: 0;
}

.tap:active {
  background: #e8e4da;
}

.side-btns {
  display: flex;
  margin: 4px 0 8px;
}

.side-btns .win-btn {
  flex: 1;
  margin-right: 6px;
  padding: 0 4px;
  font-size: 12px;
}

.side-btns .win-btn:last-child {
  margin-right: 0;
}

.rule {
  color: #b00000;
  font-size: 11px;
  line-height: 1.4;
  margin-bottom: 8px;
}

.sec-list {
  border: 1px solid #808080;
  background: #fff;
}

.sec {
  font-size: 12px;
  padding: 5px 8px;
}

.sec.on {
  background: #316ac5;
  color: #fff;
}

.sec.locked:not(.on) {
  color: #777;
}

.main {
  flex: 1;
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.typebar {
  flex-shrink: 0;
  padding: 6px 12px;
  background: #f4f4f4;
  border-bottom: 1px solid #b0b0b0;
  display: flex;
  align-items: flex-start;
}

.type-name {
  flex-shrink: 0;
  font-size: 13px;
  font-weight: 700;
  color: #1f4b99;
  margin-right: 10px;
  padding-top: 1px;
}

.type-hint {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: #333;
  line-height: 1.35;
}

.qarea {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 10px 14px;
}

.case {
  margin-bottom: 10px;
  padding: 8px 10px;
  background: #f7f7f4;
  border: 1px solid #d0d0c8;
}

.case-title {
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 4px;
  color: #1f4b99;
}

.case-stem {
  font-size: 13px;
  line-height: 1.5;
}

.stem {
  font-size: 15px;
  line-height: 1.55;
  margin-bottom: 10px;
}

.opt {
  display: flex;
  align-items: flex-start;
  padding: 6px 8px;
  margin-bottom: 4px;
  border: 1px solid transparent;
}

.opt.on {
  background: #fff6b3;
  border-color: #1f4b99;
}

.chk {
  width: 15px;
  height: 15px;
  border: 1px solid #444;
  background: #fff;
  margin-right: 8px;
  margin-top: 2px;
  flex-shrink: 0;
  text-align: center;
  font-size: 11px;
  line-height: 13px;
}

.opt-text {
  flex: 1;
  font-size: 14px;
  line-height: 1.4;
}

.locked-box {
  padding: 40px 16px;
  text-align: center;
}

.lock-title {
  font-size: 20px;
  font-weight: 700;
  color: #b00000;
}

.lock-desc {
  margin-top: 8px;
  font-size: 13px;
}

.nav {
  flex-shrink: 0;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  box-sizing: border-box;
  background: #ece9e0;
  border-top: 1px solid #808080;
  padding: 6px 10px 4px;
}

.ops {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin-bottom: 6px;
}

.ops-left {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.ops-right {
  flex: 0 0 auto;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  align-items: center;
  margin-left: 8px;
}

.ops .win-btn {
  min-width: 0 !important;
  width: auto;
  padding: 0 8px;
  font-size: 12px;
  height: 26px;
  line-height: 22px;
  margin: 0 6px 4px 0;
}

.ops-left .win-btn:last-child {
  margin-right: 0;
}

.ops-right .win-btn {
  flex-shrink: 0;
  margin-bottom: 0;
}

.ops-right .win-btn:last-child {
  margin-right: 0;
}

.ops .win-btn.marked {
  background: #ffe566;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  min-width: 28px;
  height: 20px;
  padding: 0 4px;
  margin: 0 4px 4px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: #fff;
}

.cell.unanswered {
  background: #cc2f2f;
}

.cell.answered {
  background: #7d7d7d;
}

.cell.flagged {
  background: #e3c200;
  color: #222;
}

.cell.current {
  box-shadow: inset 0 0 0 2px #111;
}

.legend {
  display: flex;
  align-items: center;
  font-size: 11px;
  color: #444;
  padding-top: 1px;
}

.lg {
  margin-right: 12px;
  padding-left: 14px;
  position: relative;
}

.lg::before {
  content: '';
  position: absolute;
  left: 0;
  top: 3px;
  width: 9px;
  height: 9px;
  border: 1px solid rgba(0, 0, 0, 0.25);
}

.lg-flag::before {
  background: #e3c200;
}

.lg-miss::before {
  background: #cc2f2f;
}

.lg-ok::before {
  background: #7d7d7d;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.28);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dlg {
  width: 72%;
  max-width: 460px;
  background: #d4d0c8;
  border-style: solid;
  border-width: 2px;
  border-color: #fff #404040 #404040 #fff;
}

.dlg-bar {
  background: #1f4b99;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  padding: 5px 8px;
}

.dlg-body {
  margin: 8px;
  padding: 12px 14px;
  background: #fff;
  font-size: 13px;
  line-height: 1.55;
  height: 140px;
}

.dlg-p {
  margin-bottom: 8px;
}

.dlg-sum {
  border-top: 1px solid #e2e2e2;
  padding-top: 8px;
}

.dlg-sum-h {
  font-weight: 700;
  color: #1f4b99;
  margin-bottom: 6px;
}

.dlg-sum-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 4px;
  font-size: 12px;
}

.dlg-sum-k {
  color: #555;
  margin-right: 10px;
  flex-shrink: 0;
}

.dlg-sum-v {
  font-weight: 700;
  text-align: right;
  min-width: 0;
  word-break: break-all;
}

.dlg-ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 8px 8px;
}

.dlg-ops .win-btn {
  margin-left: 8px;
  min-width: 88px;
}
