.exam-shell {
  position: relative;
}

.workspace {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: row;
  width: 100%;
}

.sidebar {
  width: 24%;
  min-width: 168px;
  max-width: 280px;
  height: 100%;
  flex-shrink: 0;
  background: #ece9e0;
  border-right: 1px solid #808080;
  padding: 6px 8px;
  overflow-y: auto;
}

.photo {
  width: 64px;
  height: 80px;
  margin: 0 auto 6px;
  background: #c8c8c8;
  border: 1px solid #666;
  position: relative;
}

.sil-head {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #8e97a0;
  position: absolute;
  left: 21px;
  top: 10px;
}

.sil-body {
  width: 40px;
  height: 28px;
  border-radius: 16px 16px 0 0;
  background: #8e97a0;
  position: absolute;
  left: 12px;
  top: 34px;
}

.photo-cap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 1px;
  text-align: center;
  font-size: 10px;
  color: #555;
}

.field {
  margin-bottom: 4px;
}

.lab {
  font-size: 11px;
  color: #333;
}

.val {
  font-size: 13px;
  font-weight: 700;
  word-break: break-all;
}

.val.num {
  font-size: 15px;
}

.remain {
  margin-top: 2px;
  background: #ff9ec8;
  border: 1px solid #cc5a8a;
  text-align: center;
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 1px;
  padding: 3px 0;
}

.remain.urgent {
  background: #ff5e8a;
  color: #fff;
}

.side-btns {
  display: flex;
  margin: 6px 0;
}

.side-btns .win-btn {
  flex: 1;
  margin-right: 6px;
  padding: 0 4px;
  font-size: 12px;
}

.side-btns .win-btn:last-child {
  margin-right: 0;
}

.rule {
  color: #cc0000;
  font-size: 11px;
  line-height: 1.35;
  margin-bottom: 6px;
}

.sec-list {
  border: 1px solid #808080;
  background: #fff;
}

.sec {
  font-size: 12px;
  padding: 4px 8px;
}

.sec.on {
  background: #316ac5;
  color: #fff;
}

.sec.locked:not(.on) {
  color: #666;
}

.main {
  flex: 1;
  min-width: 0;
  min-height: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #fff;
}

.typebar {
  flex-shrink: 0;
  padding: 4px 10px;
  background: #f3f3f3;
  border-bottom: 1px solid #b0b0b0;
  display: flex;
  align-items: flex-start;
}

.type-name {
  flex-shrink: 0;
  font-size: 14px;
  font-weight: 700;
  color: #1f4b99;
  margin-right: 10px;
}

.type-hint {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  color: #333;
  line-height: 1.35;
}

.qarea {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 8px 12px;
}

.case {
  margin-bottom: 8px;
  padding: 6px 8px;
  background: #f7f7f7;
  border: 1px solid #c8c8c8;
}

.case-title {
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 4px;
}

.case-stem {
  font-size: 13px;
  line-height: 1.5;
}

.stem {
  font-size: 15px;
  line-height: 1.5;
  margin-bottom: 8px;
}

.opt {
  display: flex;
  align-items: flex-start;
  padding: 5px 6px;
  margin-bottom: 4px;
  border: 2px solid transparent;
}

.opt.on {
  background: #ffff99;
  border-color: #1f4b99;
}

.chk {
  width: 14px;
  height: 14px;
  border: 1px solid #333;
  background: #fff;
  margin-right: 8px;
  margin-top: 2px;
  flex-shrink: 0;
  text-align: center;
  font-size: 11px;
  line-height: 12px;
}

.opt-text {
  flex: 1;
  font-size: 14px;
  line-height: 1.4;
}

.locked-box {
  padding: 40px 16px;
  text-align: center;
}

.lock-title {
  font-size: 22px;
  font-weight: 700;
  color: #cc0000;
}

.lock-desc {
  margin-top: 8px;
  font-size: 13px;
}

.nav {
  flex-shrink: 0;
  background: #ece9e0;
  border-top: 1px solid #808080;
  padding: 6px 10px 4px;
}

.ops {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.ops .win-btn {
  margin-right: 8px;
}

.ops .win-btn.marked {
  background: #ffe566;
}

.ops-spacer {
  flex: 1;
}

.grid {
  display: flex;
  flex-wrap: wrap;
}

.cell {
  min-width: 28px;
  height: 20px;
  padding: 0 4px;
  margin: 0 4px 4px 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  color: #fff;
}

.cell.unanswered {
  background: #e00000;
}

.cell.answered {
  background: #8a8a8a;
}

.cell.flagged {
  background: #f0d000;
  color: #000;
}

.cell.current {
  box-shadow: inset 0 0 0 2px #000;
}

.legend {
  font-size: 11px;
  color: #333;
}

.mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.28);
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dlg {
  width: 72%;
  max-width: 460px;
  background: #d4d0c8;
  border-style: solid;
  border-width: 2px;
  border-color: #fff #404040 #404040 #fff;
}

.dlg-bar {
  background: #1f4b99;
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  padding: 5px 8px;
}

.dlg-body {
  margin: 8px;
  padding: 16px;
  background: #fff;
  font-size: 14px;
  line-height: 1.6;
  min-height: 64px;
}

.dlg-ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 8px 8px;
}

.dlg-ops .win-btn {
  margin-left: 8px;
  min-width: 110px;
}
