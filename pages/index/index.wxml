<page-meta page-orientation="portrait" />
<view class="shell portrait-shell" style="{{shellStyle}}">
  <view class="titlebar" style="{{titlebarStyle}}">
    <text>{{productName}}</text>
    <text class="demo">{{productTag}}</text>
  </view>
  <scroll-view class="portrait-body" scroll-y>
    <view class="hero">
      <view class="emblem">仿</view>
      <view class="hero-name">{{productName}}</view>
      <view class="hero-sub">本地仿真练习 · 演示数据</view>
    </view>

    <view class="card">
      <view class="h">作答说明</view>
      <view class="p">登录后进入横屏作答界面：上方为考生信息与题目，下方为试题导航。</view>
      <view class="p">1. 登录：准考证号 + 证件号（可一键填入演示账号）</view>
      <view class="p">2. 左侧核对信息、剩余时间、未答题、标疑题</view>
      <view class="p">3. 底部题号红 / 灰 / 黄表示未答 / 已答 / 标疑</view>
      <view class="p">4. 分段练习：进入下一段后本段不可回看、不可修改</view>
      <view class="p">5. 交卷后可查看成绩与错题回顾</view>
    </view>

    <view class="card">
      <view class="h">使用说明</view>
      <view class="p warn">题目、成绩与登录均为演示数据，不连接后端，也不用于真实考核。</view>
      <view class="p">说明页与登录为竖屏，方便输入。进入作答后自动横屏。默认 30 分钟，可随时交卷。</view>
      <view class="p">改代码后请重新编译；真机请重新预览扫码。</view>
    </view>
  </scroll-view>
  <view class="portrait-foot">
    <button class="cta" bindtap="goLogin">进入登录</button>
  </view>
</view>
