.page {
  min-height: 100vh;
  padding: 48rpx 36rpx 80rpx;
  background: linear-gradient(180deg, #0b3a6e 0%, #0b3a6e 280rpx, #eef3f8 280rpx);
}

.hero {
  text-align: center;
  color: #fff;
  padding: 24rpx 0 48rpx;
}

.badge {
  display: inline-block;
  font-size: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
  margin-bottom: 28rpx;
  letter-spacing: 2rpx;
}

.emblem {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1a9a8f, #0e7c7b);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 30rpx rgba(0, 0, 0, 0.18);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(11, 58, 110, 0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0b3a6e;
  margin-bottom: 20rpx;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
  color: #334155;
  font-size: 26rpx;
}

.n {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #e8f4f3;
  color: #0e7c7b;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.p {
  font-size: 26rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.em {
  color: #d64545;
  font-weight: 700;
}

.cta {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: #0b3a6e;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.cta:active {
  background: #124e8c;
}

.foot {
  text-align: center;
  color: #8a93a0;
  font-size: 22rpx;
  margin-top: 28rpx;
}
