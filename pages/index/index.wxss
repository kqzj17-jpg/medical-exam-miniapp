.notice-win {
  width: 92%;
  max-width: 980px;
  overflow: auto;
}

.notice-body {
  display: flex;
  padding: 14px 12px 16px;
  min-height: 0;
  flex: 1;
}

.col {
  flex: 1;
  background: #fff;
  margin: 0 6px;
  padding: 14px 16px;
  min-height: 0;
  border: 1px solid #cfcbc3;
}

.h {
  font-size: 15px;
  font-weight: 700;
  color: #1f4b99;
  margin-bottom: 10px;
}

.p {
  font-size: 13px;
  margin-bottom: 8px;
  line-height: 1.55;
  color: #222;
}

.warn {
  color: #b00000;
}

.btns {
  display: flex;
  justify-content: flex-end;
  margin-top: 18px;
}

.btns .win-btn {
  min-width: 108px;
}
