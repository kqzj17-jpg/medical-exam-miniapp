.portrait-shell {
  background: #f3f1ea;
  font-family: "PingFang SC", "Noto Sans SC", "PingFang TC", sans-serif;
}

.portrait-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 20px 20px 8px;
}

.hero {
  text-align: center;
  margin-bottom: 20px;
}

.emblem {
  width: 64px;
  height: 64px;
  margin: 8px auto 12px;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

.hero-name {
  font-size: 20px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
}

.hero-sub {
  margin-top: 6px;
  font-size: 13px;
  color: #666;
}

.card {
  background: #fff;
  border: 1px solid #e2ddd4;
  padding: 16px 16px 8px;
  margin-bottom: 12px;
}

.h {
  font-size: 16px;
  font-weight: 700;
  color: #1f4b99;
  margin-bottom: 10px;
}

.p {
  font-size: 14px;
  margin-bottom: 8px;
  line-height: 1.55;
  color: #333;
}

.warn {
  color: #b00000;
}

.portrait-foot {
  flex-shrink: 0;
  padding: 10px 20px 16px;
  background: #f3f1ea;
}

.cta {
  width: 100%;
  height: 48px;
  line-height: 46px;
  font-size: 17px;
  font-weight: 700;
  background: #1f4b99;
  color: #fff;
  border: none;
  min-width: 0;
}

.cta::after {
  border: none;
}

.cta:active {
  background: #18407f;
}
