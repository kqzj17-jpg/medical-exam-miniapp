.notice-win {
  width: 980px;
}

.notice-body {
  display: flex;
  padding: 12px;
}

.col {
  flex: 1;
  background: #fff;
  margin: 0 6px;
  padding: 12px 14px;
  min-height: 280px;
}

.h {
  font-size: 16px;
  font-weight: 700;
  color: #1f4b99;
  margin-bottom: 8px;
}

.p {
  font-size: 13px;
  margin-bottom: 8px;
  line-height: 1.5;
}

.warn {
  color: #cc0000;
}

.btns {
  display: flex;
  justify-content: flex-end;
  margin-top: 16px;
}

.btns .win-btn {
  min-width: 100px;
}
