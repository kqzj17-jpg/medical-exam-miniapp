<page-meta page-orientation="landscape" />
<view class="shell" style="{{shellStyle}}">
  <view class="titlebar" style="{{titlebarStyle}}">
    <text>{{productName}}</text>
    <text class="demo">{{productTag}}</text>
  </view>
  <view class="desk">
    <view class="win login-win">
      <view class="titlebar">{{productName}} · 登录</view>
      <view class="login-body">
        <view class="login-left">
          <view class="emblem">仿</view>
          <view class="sys">{{productName}}</view>
          <view class="paper">{{demo.examName}}</view>
          <view class="note">本地仿真练习 · 演示数据</view>
        </view>
        <view class="login-right">
          <view class="row">
            <text class="lab">准考证号</text>
            <input class="inp" maxlength="20" value="{{ticketNo}}" bindinput="onTicket" />
          </view>
          <view class="row">
            <text class="lab">证件号</text>
            <input class="inp" maxlength="18" value="{{idNo}}" bindinput="onId" />
          </view>
          <view class="hint">演示模式不校验真实考籍。可直接登录，或一键填入示例账号。</view>
          <view class="btns">
            <button class="win-btn" bindtap="onFillDemo">演示填入</button>
            <button class="win-btn primary" bindtap="onLogin">登录</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
