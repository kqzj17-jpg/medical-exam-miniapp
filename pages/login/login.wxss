.desk {
  height: 100%;
  background: #3a6ea5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 40rpx;
}

.win {
  width: 680rpx;
  background: #d4d0c8;
  border: 2rpx solid #fff;
  border-right-color: #404040;
  border-bottom-color: #404040;
  box-shadow: 6rpx 6rpx 0 rgba(0, 0, 0, 0.2);
}

.bar {
  background: #1f4b99;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 12rpx;
}

.body {
  display: flex;
  padding: 18rpx 16rpx 16rpx;
}

.left {
  width: 220rpx;
  padding-right: 16rpx;
  border-right: 2rpx solid #808080;
  text-align: center;
}

.emblem {
  width: 72rpx;
  height: 72rpx;
  margin: 4rpx auto 8rpx;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
}

.sys {
  font-size: 22rpx;
  font-weight: 700;
}

.paper {
  margin-top: 8rpx;
  font-size: 16rpx;
  color: #333;
}

.note {
  margin-top: 10rpx;
  font-size: 16rpx;
  color: #666;
}

.right {
  flex: 1;
  padding-left: 18rpx;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.lab {
  width: 110rpx;
  font-size: 20rpx;
  flex-shrink: 0;
}

.inp {
  flex: 1;
  height: 40rpx;
  padding: 0 8rpx;
  background: #fff;
  border: 2rpx solid #808080;
  border-right-color: #fff;
  border-bottom-color: #fff;
  font-size: 20rpx;
}

.hint {
  font-size: 16rpx;
  color: #444;
  margin: 4rpx 0 12rpx;
  line-height: 1.45;
}

.btns {
  display: flex;
  justify-content: flex-end;
}

.btns .win-btn {
  margin-left: 12rpx;
  min-width: 120rpx;
  height: 40rpx;
  line-height: 36rpx;
}

.ok {
  font-weight: 700;
}
