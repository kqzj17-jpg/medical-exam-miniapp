.portrait-shell {
  background: #f3f1ea;
  font-family: "PingFang SC", "Noto Sans SC", "PingFang TC", sans-serif;
}

.portrait-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 16px 20px 8px;
}

.hero {
  text-align: center;
  margin-bottom: 24px;
}

.emblem {
  width: 64px;
  height: 64px;
  margin: 4px auto 12px;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

.hero-name {
  font-size: 20px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
}

.hero-sub {
  margin-top: 6px;
  font-size: 13px;
  color: #666;
}

.field {
  margin-bottom: 16px;
}

.lab {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8px;
}

.inp {
  width: 100%;
  height: 48px;
  min-height: 48px;
  padding: 0 14px;
  background: #fff;
  border: 1px solid #c8c3ba;
  font-size: 16px;
  line-height: 48px;
}

.hint {
  font-size: 13px;
  color: #666;
  line-height: 1.5;
  margin-top: 4px;
}

.portrait-foot {
  flex-shrink: 0;
  padding: 10px 20px 16px;
  background: #f3f1ea;
}

.cta,
.cta-ghost {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta-ghost {
  height: 44px;
  line-height: 42px;
  font-size: 16px;
  background: #fff;
  color: #1f4b99;
  border: 1px solid #1f4b99;
  margin-bottom: 10px;
}

.cta {
  height: 48px;
  line-height: 46px;
  font-size: 17px;
  font-weight: 700;
  background: #1f4b99;
  color: #fff;
  border: none;
}

.cta::after,
.cta-ghost::after {
  border: none;
}

.cta:active {
  background: #18407f;
}

.cta-ghost:active {
  background: #eef2fa;
}
