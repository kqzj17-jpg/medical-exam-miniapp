.portrait-shell {
  background: #f3f1ea;
  font-family: "PingFang SC", "Noto Sans SC", "PingFang TC", sans-serif;
}

.portrait-body {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 16px 20px 8px;
}

.hero {
  text-align: center;
  margin-bottom: 20px;
}

.avatar-btn {
  width: 72px;
  height: 72px;
  padding: 0;
  margin: 4px auto 8px;
  background: transparent;
  border: none;
  min-width: 0;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar {
  width: 72px;
  height: 72px;
  border-radius: 8px;
  background: #ddd;
}

.emblem {
  width: 72px;
  height: 72px;
  margin: 0 auto;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

.avatar-tip {
  font-size: 12px;
  color: #888;
  margin-bottom: 10px;
}

.hero-name {
  font-size: 20px;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.35;
}

.hero-sub {
  margin-top: 6px;
  font-size: 13px;
  color: #666;
}

.field {
  margin-bottom: 16px;
}

.lab {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #333;
  margin-bottom: 8px;
}

.inp {
  width: 100%;
  height: 48px;
  min-height: 48px;
  padding: 0 14px;
  background: #fff;
  border: 1px solid #c8c3ba;
  font-size: 16px;
  line-height: 48px;
}

.phone-box {
  display: flex;
  align-items: center;
  background: #fff;
  border: 1px solid #c8c3ba;
  min-height: 48px;
  padding: 4px 8px 4px 14px;
}

.phone-val {
  flex: 1;
  min-width: 0;
  font-size: 16px;
  display: flex;
  align-items: center;
}

.tag {
  margin-left: 8px;
  font-size: 11px;
  color: #1f4b99;
  border: 1px solid #1f4b99;
  padding: 0 5px;
  height: 18px;
  line-height: 16px;
}

.phone-btn {
  flex-shrink: 0;
  height: 36px;
  line-height: 34px;
  padding: 0 10px;
  margin: 0;
  font-size: 13px;
  color: #fff;
  background: #1f4b99;
  border: none;
  min-width: 0;
}

.phone-btn::after {
  border: none;
}

.hint {
  font-size: 12px;
  color: #8a5a12;
  line-height: 1.5;
  margin-top: 8px;
}

.consent {
  font-size: 12px;
  color: #777;
  line-height: 1.5;
  margin-top: 4px;
}

.portrait-foot {
  flex-shrink: 0;
  padding: 10px 20px 16px;
  background: #f3f1ea;
}

.cta,
.cta-ghost {
  width: 100%;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta-ghost {
  height: 44px;
  line-height: 42px;
  font-size: 15px;
  background: #fff;
  color: #1f4b99;
  border: 1px solid #1f4b99;
  margin-bottom: 10px;
}

.cta {
  height: 48px;
  line-height: 46px;
  font-size: 17px;
  font-weight: 700;
  background: #1f4b99;
  color: #fff;
  border: none;
}

.cta.off {
  opacity: 0.42;
}

.cta::after,
.cta-ghost::after {
  border: none;
}

.cta:active {
  background: #18407f;
}

.cta-ghost:active {
  background: #eef2fa;
}
