.login-win {
  width: 86%;
  max-width: 720px;
}

.login-body {
  display: flex;
  padding: 20px 16px 16px;
}

.login-left {
  width: 220px;
  padding-right: 16px;
  border-right: 1px solid #808080;
  text-align: center;
}

.emblem {
  width: 64px;
  height: 64px;
  margin: 8px auto;
  background: #1f4b99;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
  font-weight: 700;
}

.sys {
  font-size: 16px;
  font-weight: 700;
}

.paper {
  margin-top: 8px;
  font-size: 12px;
  color: #333;
}

.note {
  margin-top: 10px;
  font-size: 12px;
  color: #666;
}

.login-right {
  flex: 1;
  padding-left: 20px;
}

.row {
  display: flex;
  align-items: center;
  margin-bottom: 14px;
}

.lab {
  width: 80px;
  font-size: 14px;
  flex-shrink: 0;
}

.inp {
  flex: 1;
  height: 28px;
  padding: 0 8px;
  background: #fff;
  border: 1px solid #808080;
  font-size: 14px;
}

.hint {
  font-size: 12px;
  color: #444;
  margin: 4px 0 16px;
  line-height: 1.45;
}

.btns {
  display: flex;
  justify-content: flex-end;
}

.btns .win-btn {
  margin-left: 10px;
  min-width: 88px;
}
