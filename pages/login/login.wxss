.page {
  min-height: 100vh;
  padding: 40rpx 32rpx;
  background: #d9e4f0;
}

.panel {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(11, 58, 110, 0.08);
}

.head {
  background: linear-gradient(135deg, #0b3a6e, #0e7c7b);
  color: #fff;
  padding: 48rpx 40rpx 40rpx;
}

.kicker {
  font-size: 20rpx;
  letter-spacing: 1rpx;
  opacity: 0.75;
}

.h1 {
  font-size: 40rpx;
  font-weight: 700;
  margin-top: 12rpx;
  letter-spacing: 4rpx;
}

.h2 {
  margin-top: 8rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.field {
  padding: 28rpx 40rpx 0;
}

.label {
  font-size: 24rpx;
  color: #4b5563;
  margin-bottom: 12rpx;
}

.input {
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d7e0ea;
  border-radius: 8rpx;
  background: #f8fafc;
  font-size: 28rpx;
}

.hint {
  margin: 24rpx 40rpx 0;
  font-size: 22rpx;
  color: #6b7788;
  line-height: 1.6;
}

.btn {
  margin: 24rpx 40rpx 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.primary {
  background: #0b3a6e;
  color: #fff;
}

.ghost {
  background: #e8f4f3;
  color: #0e7c7b;
  margin-bottom: 40rpx;
}

.demo-card {
  margin-top: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.8;
}
