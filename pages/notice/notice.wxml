<page-meta page-orientation="landscape" />
<view class="shell exam-shell notice-shell" style="{{shellStyle}}">
  <view class="titlebar" style="{{titlebarStyle}}">
    <text>{{productName}}</text>
    <text class="demo">{{productTag}}</text>
  </view>

  <view class="workspace">
    <view class="sidebar">
      <view class="side-h">进场流程</view>
      <view class="side-sub">仿真练习 · 演示文案</view>
      <view
        wx:for="{{steps}}"
        wx:key="id"
        class="step {{index === current ? 'on' : ''}} {{index < current ? 'done' : ''}}"
      >
        <view class="step-no">{{index + 1}}</view>
        <view class="step-txt">
          <view class="step-k">{{item.kicker}}</view>
          <view class="step-t">{{item.title}}</view>
        </view>
      </view>
      <view class="disclaimer">题目、计时与成绩均为本地演示，不连接评测平台，非正式考核。</view>
    </view>

    <view class="main">
      <view class="typebar">
        <text class="type-name">{{stepTitle}}</text>
        <text class="type-hint">请阅读完整页内容后再确认。文案为仿真练习说明，非官方文件摘录。</text>
      </view>

      <scroll-view
        class="qarea"
        scroll-y
        enhanced
        show-scrollbar="{{false}}"
        bindscrolltolower="onScrollEnd"
        lower-threshold="40"
      >
        <view class="paper">
          <view class="paper-tag">演示</view>
          <view class="p" wx:for="{{paragraphs}}" wx:key="*this">{{item}}</view>
          <view class="p hint" wx:if="{{current < 2}}">请滚动至本页末尾，底栏「已阅读确认」才会点亮。</view>
        </view>
        <view wx:if="{{current === 2}}" class="agree-box" bindtap="onToggleAgree">
          <view class="chk {{agreed ? 'on' : ''}}"><text wx:if="{{agreed}}">✓</text></view>
          <view class="agree-txt">我已阅读并同意上述练习承诺（演示）</view>
        </view>
      </scroll-view>

      <view class="nav">
        <view class="ops">
          <view class="ops-left">
            <button class="win-btn" bindtap="onBack">{{current === 0 ? '返回登录' : '上一步'}}</button>
          </view>
          <view class="ops-right">
            <button
              class="win-btn primary {{canConfirm ? '' : 'off'}}"
              bindtap="onConfirm"
            >{{confirmText}}</button>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="mask" wx:if="{{reminderShow}}" catchtouchmove="noop">
    <view class="dlg">
      <view class="dlg-bar">{{reminderTitle}}</view>
      <scroll-view class="dlg-body" scroll-y show-scrollbar="{{false}}">
        <view class="dlg-p" wx:for="{{reminderLines}}" wx:key="*this">{{item}}</view>
      </scroll-view>
      <view class="dlg-ops">
        <button class="win-btn" bindtap="onReminderCancel">返回修改</button>
        <button class="win-btn primary" bindtap="onEnterExam">开始作答</button>
      </view>
    </view>
  </view>
</view>
