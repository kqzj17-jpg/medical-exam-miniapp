<view class="page">
  <view class="hero">
    <view class="ok">交卷成功</view>
    <view class="wish">祝您好运！</view>
    <view class="score">{{result.score}}</view>
    <view class="score-label">演示成绩（百分制）</view>
  </view>

  <view class="card">
    <view class="row">
      <text class="k">姓名</text>
      <text class="v">{{result.candidate.name}}</text>
    </view>
    <view class="row">
      <text class="k">准考证号</text>
      <text class="v">{{result.candidate.ticketNo}}</text>
    </view>
    <view class="row">
      <text class="k">考试科目</text>
      <text class="v">{{result.candidate.examName}}</text>
    </view>
    <view class="row">
      <text class="k">正确率</text>
      <text class="v">{{result.correct}} / {{result.total}}（{{result.accuracyText}}）</text>
    </view>
    <view class="row">
      <text class="k">用时</text>
      <text class="v">{{result.usedText}}</text>
    </view>
    <view class="row">
      <text class="k">未答题</text>
      <text class="v">{{result.unanswered}} 道</text>
    </view>
    <view class="row last" wx:if="{{result.autoSubmitted}}">
      <text class="k">交卷方式</text>
      <text class="v">倒计时结束自动交卷</text>
    </view>
  </view>

  <view class="card">
    <view class="sec-title">分段情况（演示）</view>
    <view class="sec-row" wx:for="{{sectionStats}}" wx:key="id">
      <text class="name">{{item.name}}</text>
      <text class="detail">{{item.correct}} / {{item.total}}</text>
    </view>
  </view>

  <view class="note">本题库与成绩仅为界面演示，不代表任何官方评价。</view>
  <button class="cta" bindtap="retry">再练一次</button>
  <button class="ghost" bindtap="goHome">返回首页</button>
</view>
