.result-win {
  width: 94%;
  max-width: 1040px;
  max-height: 100%;
}

.result-body {
  display: flex;
  flex: 1;
  min-height: 0;
  padding: 10px 12px 4px;
}

.hero {
  width: 250px;
  flex-shrink: 0;
  padding: 4px 12px 8px 4px;
  overflow-y: auto;
}

.ok {
  font-size: 13px;
  color: #1f4b99;
  font-weight: 700;
}

.score {
  font-size: 56px;
  font-weight: 700;
  color: #1f4b99;
  line-height: 1.05;
  margin: 4px 0 2px;
}

.score-lab {
  font-size: 11px;
  color: #666;
  margin-bottom: 8px;
}

.table {
  background: #fff;
  border: 1px solid #d0ccc4;
  padding: 2px 10px;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 5px 0;
  border-bottom: 1px solid #ece9e2;
  font-size: 12px;
}

.row:last-child {
  border-bottom: none;
}

.k {
  color: #666;
  margin-right: 8px;
  flex-shrink: 0;
}

.v {
  font-weight: 700;
  text-align: right;
  min-width: 0;
  word-break: break-all;
}

.review-wrap {
  flex: 1;
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #fff;
  border: 1px solid #d0ccc4;
}

.review-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 8px 10px;
  border-bottom: 1px solid #e4e0d8;
  background: #f7f5ef;
}

.review-title {
  font-size: 14px;
  font-weight: 700;
  color: #1f4b99;
}

.review-meta {
  margin-left: 10px;
  font-size: 12px;
  color: #555;
  flex: 1;
}

.review {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 8px 10px 10px;
}

.review-empty {
  font-size: 13px;
  color: #666;
  padding: 16px 6px;
}

.rev {
  padding: 8px 0;
  border-bottom: 1px solid #eeeae3;
}

.rev-no {
  font-size: 13px;
  line-height: 1.45;
  margin-bottom: 4px;
}

.rev-line {
  font-size: 12px;
  color: #555;
}

.rev-ans {
  margin-left: 12px;
  color: #1f4b99;
  font-weight: 700;
}

.rev.wrong .rev-line,
.rev.miss .rev-line {
  color: #8a3030;
}

.rev-exp {
  margin-top: 4px;
  font-size: 12px;
  color: #444;
  line-height: 1.45;
}

.ops {
  display: flex;
  justify-content: flex-end;
  padding: 8px 12px 10px;
  flex-shrink: 0;
}

.ops .win-btn {
  margin-left: 10px;
  min-width: 88px;
}
