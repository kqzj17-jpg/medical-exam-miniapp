.desk {
  height: 100%;
  background: #3a6ea5;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
}

.win {
  width: 820rpx;
  max-width: 100%;
  background: #d4d0c8;
  border: 2rpx solid #fff;
  border-right-color: #404040;
  border-bottom-color: #404040;
}

.bar {
  background: #1f4b99;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 12rpx;
}

.body {
  display: flex;
  padding: 12rpx;
}

.hero {
  width: 220rpx;
  text-align: center;
  padding: 10rpx 8rpx;
}

.ok {
  font-size: 20rpx;
  color: #cc0000;
  font-weight: 700;
}

.score {
  font-size: 72rpx;
  font-weight: 700;
  color: #1f4b99;
  line-height: 1.1;
  margin-top: 8rpx;
}

.score-lab {
  font-size: 16rpx;
  color: #444;
}

.table {
  flex: 1;
  background: #fff;
  padding: 6rpx 14rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0;
  border-bottom: 1rpx solid #e0e0e0;
  font-size: 18rpx;
}

.k {
  color: #444;
}

.v {
  font-weight: 700;
}

.ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 12rpx 12rpx;
}

.ops .win-btn {
  margin-left: 12rpx;
  min-width: 120rpx;
  height: 40rpx;
  line-height: 36rpx;
}

.ok {
  font-weight: 700;
}
