.result-win {
  width: 860px;
}

.result-body {
  display: flex;
  padding: 12px;
}

.hero {
  width: 220px;
  text-align: center;
  padding: 12px 8px;
}

.ok {
  font-size: 14px;
  color: #cc0000;
  font-weight: 700;
}

.score {
  font-size: 64px;
  font-weight: 700;
  color: #1f4b99;
  line-height: 1.1;
  margin-top: 8px;
}

.score-lab {
  font-size: 12px;
  color: #444;
}

.table {
  flex: 1;
  background: #fff;
  padding: 6px 14px;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
  border-bottom: 1px solid #e0e0e0;
  font-size: 13px;
}

.k {
  color: #444;
}

.v {
  font-weight: 700;
}

.ops {
  display: flex;
  justify-content: flex-end;
  padding: 0 12px 12px;
}

.ops .win-btn {
  margin-left: 10px;
  min-width: 88px;
}
