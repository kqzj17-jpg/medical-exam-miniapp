.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  background: #eef3f8;
}

.hero {
  text-align: center;
  padding: 48rpx 24rpx 32rpx;
}

.ok {
  font-size: 28rpx;
  color: #0e7c7b;
  font-weight: 700;
}

.wish {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7788;
}

.score {
  margin-top: 12rpx;
  font-size: 112rpx;
  font-weight: 700;
  color: #0b3a6e;
  line-height: 1.1;
}

.score-label {
  font-size: 22rpx;
  color: #8a93a0;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eef2f6;
  font-size: 26rpx;
}

.row.last {
  border-bottom: none;
}

.k {
  color: #6b7788;
}

.v {
  color: #1c2430;
  font-weight: 600;
  max-width: 70%;
  text-align: right;
}

.sec-title {
  padding: 20rpx 0 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #0b3a6e;
}

.sec-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0 22rpx;
  font-size: 26rpx;
}

.name {
  color: #334155;
}

.detail {
  color: #0e7c7b;
  font-weight: 600;
}

.note {
  font-size: 22rpx;
  color: #8a93a0;
  text-align: center;
  margin: 8rpx 12rpx 24rpx;
}

.cta {
  height: 88rpx;
  line-height: 88rpx;
  background: #0b3a6e;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.ghost {
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #fff;
  color: #0b3a6e;
  border-radius: 12rpx;
  font-size: 28rpx;
}
